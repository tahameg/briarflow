{
  "name": "@briarflow/runtime",
  "version": "0.0.0",
  "description": "Execution engine for Briarflow flows.",
  "type": "module",
  "license": "MIT",
  "//": "exports point at source during development; the build (tsdown) will produce dist/ and publishConfig will switch exports to it.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist --clean"
  },
  "dependencies": {
    "@briarflow/core": "*"
  }
}
