{
  "name": "@briarflow/server",
  "version": "0.0.0",
  "description": "Briarflow REST + SSE API (Hono) over the briarflow facade.",
  "type": "module",
  "license": "MIT",
  "//": "exports point at source during development; the build (tsdown) will produce dist/ and publishConfig will switch exports to it.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist --clean"
  },
  "dependencies": {
    "@briarflow/authoring": "*",
    "@briarflow/core": "*",
    "@hono/node-server": "^1.19.17",
    "briarflow": "*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@briarflow/client": "*",
    "@briarflow/nodes-mock": "*"
  }
}
