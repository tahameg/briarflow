{
  "name": "@briarflow/storage-sqlite",
  "version": "0.0.0",
  "description": "SQLite ContextStore for Briarflow.",
  "type": "module",
  "license": "MIT",
  "//": "exports point at source during development; the build (tsdown) will produce dist/ and publishConfig will switch exports to it.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist --clean"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@briarflow/core": "*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
